	(text "03  POWER STAGE  -  12x N-channel, 2 per switch position"
		(exclude_from_sim yes)
		(at 40 35 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "89c10c7c-3ae4-5a1e-8efe-2677a31b10e9")
	)
	(text "TPHR8504PL 40 V / 0.85 mOhm max. 40 V on a 12.6 V bus is"
		(exclude_from_sim yes)
		(at 40 45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "50e2562b-ec73-51e6-803a-0bd6f95d97da")
	)
	(text "deliberate: a 150 A edge into ~5 nH of loop inductance adds"
		(exclude_from_sim yes)
		(at 40 49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "910d9e1e-034c-53a7-abd3-dfa596e2bfea")
	)
	(text "7.5 V of overshoot and real layouts do worse."
		(exclude_from_sim yes)
		(at 40 53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d266a29f-f5e8-58a3-b5fb-8e481f883fd7")
	)
	(text "EVERY FET has its OWN series gate resistor. Two gates tied"
		(exclude_from_sim yes)
		(at 40 325 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a381cec5-5d99-5779-b0b2-215d068b0bcf")
	)
	(text "directly together resonate through their package inductance"
		(exclude_from_sim yes)
		(at 40 329 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "53fecae5-80de-5933-9692-7d94b9043dd2")
	)
	(text "and oscillate -- separate resistors de-Q that loop. This is"
		(exclude_from_sim yes)
		(at 40 333 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0f6e01c8-4da8-5ae4-a1dd-27d019579db3")
	)
	(text "mandatory for paralleled FETs, not optional."
		(exclude_from_sim yes)
		(at 40 337 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "583a7b26-6bd4-5e86-8d58-11e4810a0850")
	)
	(text "Every FET also has a 10k gate-source pulldown, so a floating"
		(exclude_from_sim yes)
		(at 40 345 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "66c37042-79db-5611-bcb8-d0ba8185cfa3")
	)
	(text "gate cannot be turned on through Cgd by drain dv/dt."
		(exclude_from_sim yes)
		(at 40 349 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d8590294-dfa4-5852-aad3-157b18ab5b1b")
	)
	(text "Dxxx bypasses the common gate resistor on turn-OFF only, so"
		(exclude_from_sim yes)
		(at 400 325 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "95cbed04-b542-57ce-bdad-5610dc52243d")
	)
	(text "turn-off is faster than turn-on -- this widens effective dead"
		(exclude_from_sim yes)
		(at 400 329 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "32894d08-4044-5bf6-a749-bd22842df705")
	)
	(text "time. Asymmetry is in the safe direction. See shoot-through.md."
